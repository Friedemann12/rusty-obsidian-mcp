# Required: Obsidian vault name (replace or use cli argument --vault MyVault)
OBSIDIAN_VAULT=MyVault

# Optional: path to obsidian binary (default: "obsidian")
# OBSIDIAN_BIN=obsidian

# Optional: CLI timeout in seconds (default: 30)
# OBSIDIAN_TIMEOUT=30

# Optional: enable dangerous tools (eval_js, execute_command)
# ENABLE_DANGEROUS_TOOLS=true

# Optional: API key for HTTP/tunnel authentication.
# Auto-generated if not set. Required for --http and --tunnel modes.
# MCP_API_KEY=your-secret-key-here

# Required for --transport tunnel:
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: stable ngrok dev domain (default: random URL)
# Get yours free at https://dashboard.ngrok.com/domains
# NGROK_DOMAIN=your-name.ngrok-free.app
